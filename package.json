{
  "name": "json-schema-form-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev -w @jsb/server\" \"npm:dev -w @jsb/web\"",
    "build": "npm run build -w @jsb/server && npm run build -w @jsb/web",
    "start": "node packages/server/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
